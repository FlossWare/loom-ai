# Loom dogfood configuration template.
# Copy to .env with ./scripts/setup.sh, then replace placeholders.
# Never commit real credentials.

# LLM
LOOM_LLM_PROVIDER=openai-compatible
LOOM_LLM_BASE_URL=https://your-provider.example/v1
LOOM_LLM_API_KEY=replace-me
LOOM_LLM_MODEL=replace-me

# Embeddings: noop is not valid for persistent dogfood.
LOOM_EMBEDDING=litellm

# Persistent storage for production-style dogfood.
LOOM_STORAGE=postgresql
LOOM_PG_HOST=localhost
LOOM_PG_PORT=5432

# Redis is only required when using the Redis queue backend.
LOOM_QUEUE=memory
LOOM_REDIS_HOST=localhost
LOOM_REDIS_PORT=6379

# Require GitHub CLI/authentication for GitHub-backed publication workflows.
LOOM_REQUIRE_GITHUB=1

# Keep canary mode enabled for dogfood.
LOOM_CANARY=1
